# CodeLens — gitignore

# Environment variables & secrets
.env
.env.*
*.env
backend/.env
frontend/.env

# Python
__pycache__/
*.py[cod]
*$py.class
backend/__pycache__/
backend/*.pyc
.venv/
venv/
env/

# Node & Build
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
*.local

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*

# Editor & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
